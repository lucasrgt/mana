defmodule MyApp.Moments.Hosts do
  @moduledoc "The host's situations."
  use Ash.Domain, extensions: [Moments.Extension]

  moments do
    route "/host/properties"

    # Publishing from the property's page.
    moment :property_published do
      description "The host publishes a draft property."
      backend :draft_property
      # The publish control is drawn by a VerbGate.
      step(:publish, tap: "property-detail-publish", until: [:public])
      step :open_menu, tap: "property-detail-menu"

      step :pause do
        # A step written as a block.
        tap "partner-ad-pause"
      end

      step :shared, tap: "shared-key", until: [:paused]
      check :public, kind: :ui_equals, field: :public, equals: true
    end
  end
end

defmodule MyApp.Onboarding do
  @moduledoc "Not a Moments section: its steps stay as written."
  use MyApp.Steps

  steps do
    step :publish, tap: "property-detail-publish"
  end
end
