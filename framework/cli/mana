#!/bin/sh
# Runs the Mana CLI, compiling it again when its Dart sources changed.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
exe="$here/.dart_tool/mana"
if [ ! -x "$exe" ] || [ -n "$(find "$here/bin" "$here/lib" "$here/pubspec.lock" -newer "$exe" -print -quit)" ]; then
  (cd "$here" && dart pub get --enforce-lockfile >/dev/null && dart compile exe bin/mana.dart -o "$exe.$$" >/dev/null && mv -f "$exe.$$" "$exe")
fi
exec "$exe" "$@"
